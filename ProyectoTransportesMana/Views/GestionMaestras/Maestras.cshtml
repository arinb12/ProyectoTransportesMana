@{
    ViewData["Title"] = "Gestión Maestras";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/principal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/datatables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/gestion-common.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/maestras/gestion-maestras.css" asp-append-version="true" />

}

<!-- Loading Overlay -->
<div class="tm-loading-overlay" id="loading-overlay">
    <div class="tm-loading-content">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-3 tm-text-muted">Cargando maestras...</p>
    </div>
</div>

<!-- Page Header -->
<div class="tm-page-header">
    <h1 class="tm-page-title">
        <i class="bi bi-person-badge-fill"></i>
        Gestión de Maestras
    </h1>
    <button class="tm-btn tm-btn-primary" data-bs-toggle="modal" data-bs-target="#modalMaestra" onclick="nuevaMaestra()">
        <i class="bi bi-plus-lg me-1"></i>
        Nueva Maestra
    </button>
</div>

<!-- Stats Cards -->
<div class="tm-stats-grid">
    <div class="tm-stat-card">
        <div class="tm-stat-icon primary">
            <i class="bi bi-people-fill"></i>
        </div>
        <div class="tm-stat-content">
            <div class="tm-stat-value" id="stats-total-maestras">0</div>
            <div class="tm-stat-label">Total Maestras</div>
        </div>
    </div>
    <div class="tm-stat-card">
        <div class="tm-stat-icon secondary">
            <i class="bi bi-person-check-fill"></i>
        </div>
        <div class="tm-stat-content">
            <div class="tm-stat-value" id="stats-maestras-activas">0</div>
            <div class="tm-stat-label">Maestras Activas</div>
        </div>
    </div>
    <div class="tm-stat-card">
        <div class="tm-stat-icon accent">
            <i class="bi bi-building-fill"></i>
        </div>
        <div class="tm-stat-content">
            <div class="tm-stat-value" id="stats-instituciones">0</div>
            <div class="tm-stat-label">Instituciones</div>
        </div>
    </div>
</div>

<!-- Desktop: Maestras Table Card -->
<div class="tm-card tm-maestras-desktop">
    <div class="tm-card-header">
        <span><i class="bi bi-table me-2"></i>Listado de Maestras</span>
    </div>
    <div class="tm-card-body">
        <table id="tablaMaestras" class="table table-hover w-100">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Institución</th>
                    <th>Sección</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody id="tbodyMaestras">
                <!-- Data loaded via JavaScript -->
            </tbody>
        </table>
    </div>
</div>

<!-- Mobile: Maestras Cards View -->
<div class="tm-card tm-maestras-mobile">
    <div class="tm-card-header">
        <span><i class="bi bi-person-badge me-2"></i>Listado de Maestras</span>
    </div>

    <!-- Mobile Controls -->
    <div class="tm-mobile-controls">
        <div class="tm-mobile-search">
            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" class="form-control" id="mobileSearchMaestras"
                       placeholder="Buscar maestra...">
            </div>
        </div>
        <div class="tm-mobile-filter">
            <select class="form-select" id="mobileFilterEstado">
                <option value="">Todos</option>
                <option value="activo">Activas</option>
                <option value="inactivo">Inactivas</option>
            </select>
            <select class="form-select" id="mobilePageSize">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
            </select>
        </div>
    </div>

    <!-- Maestra Cards Container -->
    <div class="tm-maestra-cards" id="maestraCardsContainer">
        <!-- Cards will be rendered here by JavaScript -->
    </div>

    <!-- Mobile Pagination -->
    <div class="tm-mobile-pagination" id="mobilePaginationMaestras">
        <div class="tm-pagination-info">
            Mostrando <strong>1-10</strong> de <strong>0</strong> maestras
        </div>
        <div class="tm-pagination-controls">
            <button class="tm-page-btn tm-page-prev" disabled>
                <i class="bi bi-chevron-left"></i>
            </button>
            <div class="tm-page-numbers">
                <!-- Page numbers rendered by JS -->
            </div>
            <button class="tm-page-btn tm-page-next" disabled>
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>
</div>

<!-- Modal: Nueva/Editar Maestra -->
<div class="modal fade" id="modalMaestra" tabindex="-1" aria-labelledby="modalMaestraLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalMaestraLabel">
                    <i class="bi bi-person-plus me-2"></i>
                    Registrar Maestra
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="maestraForm" class="row g-3" novalidate>
                    <input type="hidden" id="IdMaestra" value="0" />

                    <!-- Nombre -->
                    <div class="col-md-12">
                        <label for="Nombre" class="form-label">
                            Nombre Completo <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="Nombre" class="form-control"
                               placeholder="Ingrese el nombre completo" required />
                    </div>

                    <!-- Institución -->
                    <div class="col-md-6">
                        <label for="IdInstitucion" class="form-label">
                            Institución <span class="text-danger">*</span>
                        </label>
                        <select id="IdInstitucion" class="form-select" required>
                            <option value="">Seleccione una institución</option>
                        </select>
                    </div>

                    <!-- Sección -->
                    <div class="col-md-6">
                        <label for="Seccion" class="form-label">
                            Sección <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="Seccion" class="form-control"
                               placeholder="Ej: 1-A, Kinder B" required />
                    </div>

                    <!-- Activo -->
                    <div class="col-md-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="Activo" checked />
                            <label class="form-check-label" for="Activo">Activa</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="tm-btn tm-btn-outline" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="submit" form="maestraForm" class="tm-btn tm-btn-primary">
                    <i class="bi bi-check-lg me-1"></i>
                    Guardar Maestra
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/utilitarios/utilitarios.js" asp-append-version="true"></script>
    <script src="~/js/utilitarios/swal-helpers.js" asp-append-version="true"></script>
    <script src="~/js/shared/gestion-common.js" asp-append-version="true"></script>
    <script src="~/js/maestras/gestion-maestras.js" asp-append-version="true"></script>
}
