@{
    var nombreUsuario = Context.Session.GetString("NombreUsuario") ?? "";
    var nombreRol = Context.Session.GetString("RolUsuario") ?? "";
    int? rol = Context.Session.GetInt32("IdRol");
    var idUsuario = Context.Session.GetInt32("IdUsuario")?.ToString() ?? "0";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sistema de Gestión de Transporte Escolar" />
    <meta name="theme-color" content="#1e3a5f" />
    <title>@ViewData["Title"] - Transportes Mana</title>

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Typography -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Bootstrap CSS & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- DataTables CSS -->
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" rel="stylesheet" />

    <!-- Custom Theme Styles -->
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <!-- FULLY REMOVE AT THE END OF THE FRONTEND REBRAND -->
    @* <link rel="stylesheet" href="~/css/index/index.css" asp-append-version="true" /> *@
    
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    @Html.AntiForgeryToken()

    <!-- Skip Link for Keyboard Users -->
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

    <!-- Mobile Overlay -->
    <div class="tm-overlay" id="sidebarOverlay" aria-hidden="true"></div>

    <div class="tm-layout">
        <!-- Sidebar Navigation -->
        <aside class="tm-sidebar" id="sidebar" aria-label="Navegación principal">
            <div class="tm-sidebar-header">
                <div class="tm-logo" aria-hidden="true">
                    <i class="bi bi-bus-front"></i>
                </div>
                <span class="tm-brand">Transportes Mana</span>
            </div>
            <nav class="tm-sidebar-nav">
                @if (rol == 1)
                {
                    <!-- Admin: Full Menu -->
                    <div class="tm-nav-section">
                        <div class="tm-nav-title">Principal</div>
                        <a asp-controller="Home" asp-action="Principal" class="tm-nav-link">
                            <i class="bi bi-house-door"></i>
                            <span class="tm-link-text">Inicio</span>
                        </a>
                        <a asp-controller="Alerta" asp-action="ConsultarAlerta" class="tm-nav-link">
                            <i class="bi bi-megaphone"></i>
                            <span class="tm-link-text">Comunicados</span>
                            <span class="tm-nav-badge" id="notifsCount" style="display:none;">0</span>
                        </a>
                    </div>

                    <div class="tm-nav-section">
                        <div class="tm-nav-title">Administración</div>
                        <a href="#" class="tm-nav-link tm-nav-toggle"
                           role="button"
                           aria-expanded="false"
                           aria-controls="gestionSubmenu"
                           onclick="toggleSubmenu(this, 'gestionSubmenu')">
                            <i class="bi bi-gear"></i>
                            <span class="tm-link-text">Gestión</span>
                        </a>
                        <div class="tm-submenu" id="gestionSubmenu">
                            <a asp-controller="Estudiantes" asp-action="GestionEstudiantes" class="tm-nav-link">
                                <i class="bi bi-mortarboard"></i>
                                <span class="tm-link-text">Estudiantes</span>
                            </a>
                            <a asp-controller="GestionMaestras" asp-action="Maestras" class="tm-nav-link">
                                <i class="bi bi-person-badge"></i>
                                <span class="tm-link-text">Maestras</span>
                            </a>
                            <a asp-controller="EncargadosLegales" asp-action="GestionEncargadosLegales" class="tm-nav-link">
                                <i class="bi bi-people"></i>
                                <span class="tm-link-text">Padres</span>
                            </a>
                            <a asp-controller="Busetas" asp-action="Index" class="tm-nav-link">
                                <i class="bi bi-bus-front"></i>
                                <span class="tm-link-text">Busetas</span>
                            </a>
                            <a asp-controller="Asistente" asp-action="ConsultarAsistente" class="tm-nav-link">
                                <i class="bi bi-person-check"></i>
                                <span class="tm-link-text">Asistentes</span>
                            </a>
                            <a asp-controller="Instituciones" asp-action="ConsultarInstitucion" class="tm-nav-link">
                                <i class="bi bi-building"></i>
                                <span class="tm-link-text">Escuelas</span>
                            </a>
                            <a asp-controller="Usuarios" asp-action="GestionUsuarios" class="tm-nav-link">
                                <i class="bi bi-person-gear"></i>
                                <span class="tm-link-text">Usuarios</span>
                            </a>
                        </div>
                    </div>

                    <div class="tm-nav-section">
                        <div class="tm-nav-title">Operaciones</div>
                        <a href="#" class="tm-nav-link tm-nav-toggle"
                           role="button"
                           aria-expanded="false"
                           aria-controls="viajesSubmenu"
                           onclick="toggleSubmenu(this, 'viajesSubmenu')">
                            <i class="bi bi-truck"></i>
                            <span class="tm-link-text">Viajes</span>
                        </a>
                        <div class="tm-submenu" id="viajesSubmenu">
                            <a asp-controller="Asistencia" asp-action="GestionAsistencia" class="tm-nav-link">
                                <i class="bi bi-clipboard-check"></i>
                                <span class="tm-link-text">Control de Asistencia</span>
                            </a>
                            <a asp-controller="Asistencia" asp-action="HistorialAsistencia" class="tm-nav-link">
                                <i class="bi bi-clock-history"></i>
                                <span class="tm-link-text">Historial</span>
                            </a>
                        </div>
                    </div>
                }
                else if (rol == 2)
                {
                    <!-- Encargado (Parent): Limited Menu -->
                    <div class="tm-nav-section">
                        <div class="tm-nav-title">Principal</div>
                        <a asp-controller="Alerta" asp-action="ConsultarAlerta" class="tm-nav-link">
                            <i class="bi bi-megaphone"></i>
                            <span class="tm-link-text">Comunicados</span>
                            <span class="tm-nav-badge" id="notifsCount" style="display:none;">0</span>
                        </a>
                    </div>
                }
                else if (rol == 5)
                {
                    <!-- Asistente: Comunicados + Viajes -->
                    <div class="tm-nav-section">
                        <div class="tm-nav-title">Principal</div>
                        <a asp-controller="Alerta" asp-action="ConsultarAlerta" class="tm-nav-link">
                            <i class="bi bi-megaphone"></i>
                            <span class="tm-link-text">Comunicados</span>
                            <span class="tm-nav-badge" id="notifsCount" style="display:none;">0</span>
                        </a>
                    </div>

                    <div class="tm-nav-section">
                        <div class="tm-nav-title">Operaciones</div>
                        <a href="#" class="tm-nav-link tm-nav-toggle"
                           role="button"
                           aria-expanded="false"
                           aria-controls="viajesSubmenuAsist"
                           onclick="toggleSubmenu(this, 'viajesSubmenuAsist')">
                            <i class="bi bi-truck"></i>
                            <span class="tm-link-text">Viajes</span>
                        </a>
                        <div class="tm-submenu" id="viajesSubmenuAsist">
                            <a asp-controller="Asistencia" asp-action="GestionAsistencia" class="tm-nav-link">
                                <i class="bi bi-clipboard-check"></i>
                                <span class="tm-link-text">Control de Asistencia</span>
                            </a>
                            <a asp-controller="Asistencia" asp-action="HistorialAsistencia" class="tm-nav-link">
                                <i class="bi bi-clock-history"></i>
                                <span class="tm-link-text">Historial</span>
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Default/Other Roles -->
                    <div class="tm-nav-section">
                        <div class="tm-nav-title">Principal</div>
                        <a asp-controller="Home" asp-action="Principal" class="tm-nav-link">
                            <i class="bi bi-house-door"></i>
                            <span class="tm-link-text">Inicio</span>
                        </a>
                    </div>
                }

                @if (rol == 1 || rol == 2)
                {
                    <!-- Portal de Padres -->
                    <div class="tm-nav-section">
                        <div class="tm-nav-title">Portal de Padres</div>
                        <a asp-controller="PortalPadres" asp-action="Index" class="tm-nav-link">
                            <i class="bi bi-laptop"></i>
                            <span class="tm-link-text">Vista Portal</span>
                        </a>
                        <a asp-controller="PortalPadres" asp-action="GestionHijos" class="tm-nav-link">
                            <i class="bi bi-person-heart"></i>
                            <span class="tm-link-text">Gestionar Hijos</span>
                        </a>
                    </div>
                }
            </nav>
        </aside>

        <!-- Main Content -->
        <div class="tm-main">
            <!-- Top Navbar -->
            <header class="tm-navbar">
                <button class="tm-toggle-btn"
                        id="sidebarToggle"
                        type="button"
                        aria-label="Alternar menú lateral"
                        aria-expanded="true"
                        aria-controls="sidebar">
                    <i class="bi bi-list"></i>
                </button>

                <div class="tm-navbar-end">
                    <!-- User Menu -->
                    <div class="tm-user-menu">
                        <button class="tm-user-btn"
                                id="userMenuBtn"
                                type="button"
                                aria-haspopup="true"
                                aria-expanded="false">
                            <div class="tm-user-avatar">
                                @(string.IsNullOrEmpty(nombreUsuario) ? "U" : nombreUsuario[0].ToString().ToUpper())
                            </div>
                            <div class="tm-user-info">
                                <div class="tm-user-name">@nombreUsuario</div>
                                <div class="tm-user-role">@nombreRol</div>
                            </div>
                            <i class="bi bi-chevron-down" style="font-size: 0.75rem; color: var(--tm-text-muted);"></i>
                        </button>
                        <div class="tm-dropdown" id="userDropdown" role="menu">
                            <a asp-action="Index" asp-controller="Perfil" class="tm-dropdown-item" role="menuitem">
                                <i class="bi bi-person"></i>
                                Mi Perfil
                            </a>
                            <div class="tm-dropdown-divider"></div>
                            <a asp-action="CerrarSesion" asp-controller="Home" class="tm-dropdown-item danger" role="menuitem">
                                <i class="bi bi-box-arrow-right"></i>
                                Cerrar Sesión
                            </a>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="tm-content" id="main-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Hidden User ID for JavaScript -->
    <input type="hidden" id="__currentUserId" value="@idUsuario" />

    @inject IConfiguration Configuration

    <script>
        // Global Configuration
        window.API_BASE = '@(Configuration["Api:BaseUrl"]?.TrimEnd('/') ?? "https://localhost:7238")';
        window.CURRENT_USER_ID = '@idUsuario';
        window.ROL_ACTUAL = @((rol ?? 0));
    </script>

    <!-- Core Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://unpkg.com/imask"></script>

    <script>
        // ============================================
        // SIDEBAR & NAVIGATION FUNCTIONALITY
        // ============================================
        
        const sidebar = document.getElementById('sidebar');
        const sidebarToggle = document.getElementById('sidebarToggle');
        const sidebarOverlay = document.getElementById('sidebarOverlay');

        const sidebarCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
        if (sidebarCollapsed && window.innerWidth >= 992) {
            sidebar.classList.add('collapsed');
        }

        // Sidebar Toggle Handler
        sidebarToggle.addEventListener('click', () => {
            if (window.innerWidth < 992) {
                sidebar.classList.toggle('mobile-open');
                sidebarOverlay.classList.toggle('show');
            } else {
                sidebar.classList.toggle('collapsed');
                localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('collapsed'));
                
                if (sidebar.classList.contains('collapsed')) {
                    enableTooltips();
                } else {
                    disableTooltips();
                }
            }
        });

        sidebarOverlay.addEventListener('click', () => {
            sidebar.classList.remove('mobile-open');
            sidebarOverlay.classList.remove('show');
        });

        function toggleSubmenu(trigger, submenuId) {
            const submenu = document.getElementById(submenuId);
            const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

            trigger.setAttribute('aria-expanded', !isExpanded);
            submenu.classList.toggle('show');
        }

        // ============================================
        // TOOLTIP FUNCTIONALITY FOR COLLAPSED SIDEBAR
        // ============================================
        
        function enableTooltips() {
            const navLinks = document.querySelectorAll('.tm-nav-link');
            navLinks.forEach(link => {
                const text = link.querySelector('.tm-link-text')?.textContent?.trim();
                if (text && !link.hasAttribute('data-bs-toggle')) {
                    link.setAttribute('data-bs-toggle', 'tooltip');
                    link.setAttribute('data-bs-placement', 'right');
                    link.setAttribute('data-bs-title', text);
                    link.setAttribute('title', text);
                }
            });
            
            const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            [...tooltipTriggerList].forEach(el => new bootstrap.Tooltip(el));
        }

        function disableTooltips() {
            const tooltips = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            tooltips.forEach(el => {
                const tooltip = bootstrap.Tooltip.getInstance(el);
                if (tooltip) {
                    tooltip.dispose();
                }
                el.removeAttribute('data-bs-toggle');
                el.removeAttribute('data-bs-placement');
                el.removeAttribute('data-bs-title');
                el.removeAttribute('title');
            });
        }

        // ============================================
        // USER DROPDOWN MENU
        // ============================================
        
        const userMenuBtn = document.getElementById('userMenuBtn');
        const userDropdown = document.getElementById('userDropdown');

        userMenuBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isExpanded = userMenuBtn.getAttribute('aria-expanded') === 'true';
            userMenuBtn.setAttribute('aria-expanded', !isExpanded);
            userDropdown.classList.toggle('show');
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', (e) => {
            if (!userDropdown.contains(e.target) && !userMenuBtn.contains(e.target)) {
                userMenuBtn.setAttribute('aria-expanded', 'false');
                userDropdown.classList.remove('show');
            }
        });

        // ============================================
        // NOTIFICATION COUNTER
        // ============================================
        
        async function actualizarContadorAlertas() {
            try {
                const badge = document.getElementById('notifsCount');
                if (!badge || !window.CURRENT_USER_ID || window.CURRENT_USER_ID === '0') {
                    if (badge) badge.style.display = 'none';
                    return;
                }

                const resp = await fetch('/Alerta/GetCountAlertasParaUsuario', {
                    method: 'GET',
                    headers: { 'Accept': 'application/json' },
                    credentials: 'same-origin'
                });

                if (!resp.ok) return;

                const data = await resp.json();
                const count = data?.count ?? data?.length ?? 0;

                badge.textContent = count;
                badge.style.display = count > 0 ? 'inline-block' : 'none';
            } catch (err) {
                console.error('Error updating alert count:', err);
            }
        }

        // ============================================
        // PAGE LIFECYCLE HANDLERS
        // ============================================
        
        // Force reload on browser back/forward navigation
        window.addEventListener('pageshow', (event) => {
            if (event.persisted || performance.getEntriesByType('navigation')[0]?.type === 'back_forward') {
                window.location.reload();
            }
        });

        // ============================================
        // INITIALIZATION
        // ============================================
        
        document.addEventListener('DOMContentLoaded', () => {
            // Initialize notification counter
            actualizarContadorAlertas();
            setInterval(actualizarContadorAlertas, 60000); // Update every minute
            
            // Enable tooltips if sidebar is already collapsed on page load
            if (sidebar.classList.contains('collapsed')) {
                enableTooltips();
            }
        });
    </script>

    <script src="~/js/utilitarios/utilitarios.js" asp-append-version="true"></script>
    <script src="~/js/utilitarios/swal-helpers.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>