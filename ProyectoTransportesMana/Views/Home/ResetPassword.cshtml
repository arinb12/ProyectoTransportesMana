@{
    ViewData["Title"] = "Restablecer Contraseña";
    Layout = "_LayoutExterno";
}

<div class="login-page">
    <!-- Animated Background -->
    <div class="login-bg">
        <div class="login-bg-shape login-bg-shape-1"></div>
        <div class="login-bg-shape login-bg-shape-2"></div>
        <div class="login-bg-shape login-bg-shape-3"></div>
    </div>

    <!-- Main Container -->
    <div class="login-wrapper">
        <div class="login-card">
            <!-- Left Panel - Form -->
            <div class="login-form-panel">
                <!-- Logo & Brand -->
                <div class="login-brand">
                    <div class="login-logo">
                        <i class="bi bi-bus-front-fill"></i>
                    </div>
                    <span class="login-brand-text">Transporte Maná</span>
                </div>

                <!-- Header Text -->
                <div class="login-welcome">
                    <h1>Restablecer Contraseña</h1>
                    <p>Ingresa tu nueva contraseña para recuperar el acceso a tu cuenta.</p>
                </div>

                <!-- Error Message -->
                @if (ViewBag.Mensaje != null)
                {
                    <div class="login-alert" role="alert">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span>@ViewBag.Mensaje</span>
                    </div>
                }

                <!-- Reset Password Form -->
                <form id="FormRestablecerContrasena" class="login-form" method="POST" asp-action="ActualizarPassword" asp-controller="Home" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="token" value="@ViewBag.Token" />

                    <!-- New Password Field -->
                    <div class="form-floating-custom">
                        <div class="input-icon">
                            <i class="bi bi-lock"></i>
                        </div>
                        <input type="password"
                               id="new_password"
                               name="new_password"
                               class="form-input"
                               placeholder="••••••••"
                               autocomplete="new-password"
                               required />
                        <label for="new_password">Nueva contraseña</label>
                        <button type="button" class="password-toggle" aria-label="Mostrar contraseña">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                    <!-- Confirm Password Field -->
                    <div class="form-floating-custom">
                        <div class="input-icon">
                            <i class="bi bi-lock-fill"></i>
                        </div>
                        <input type="password"
                               id="confirm_password"
                               name="confirm_password"
                               class="form-input"
                               placeholder="••••••••"
                               autocomplete="new-password"
                               required />
                        <label for="confirm_password">Confirmar contraseña</label>
                        <button type="button" class="password-toggle" aria-label="Mostrar contraseña">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                    <!-- Password Requirements -->
                    <div class="password-requirements">
                        <p class="requirements-title">La contraseña debe contener:</p>
                        <ul class="requirements-list">
                            <li id="req-length" class="requirement">
                                <i class="bi bi-circle"></i>
                                <span>Mínimo 8 caracteres</span>
                            </li>
                            <li id="req-uppercase" class="requirement">
                                <i class="bi bi-circle"></i>
                                <span>Una letra mayúscula</span>
                            </li>
                            <li id="req-number" class="requirement">
                                <i class="bi bi-circle"></i>
                                <span>Un número</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn-login">
                        <span>Actualizar Contraseña</span>
                        <i class="bi bi-check-lg"></i>
                    </button>
                </form>

                <!-- Back to Login -->
                <div class="login-back">
                    <a asp-action="Index" asp-controller="Home" class="back-link">
                        <i class="bi bi-arrow-left"></i>
                        <span>Volver al inicio de sesión</span>
                    </a>
                </div>

                <!-- Footer -->
                <div class="login-footer">
                    <p>© @DateTime.Now.Year Transporte Escolar Maná. Todos los derechos reservados.</p>
                </div>
            </div>

            <!-- Right Panel - Illustration -->
            <div class="login-illustration-panel">
                <div class="illustration-content">
                    <div class="illustration-icon">
                        <i class="bi bi-key-fill"></i>
                    </div>
                    <h2>Crea una contraseña segura</h2>
                    <p>Elige una contraseña única para mantener tu cuenta protegida.</p>

                    <!-- Security Tips -->
                    <ul class="feature-list">
                        <li>
                            <i class="bi bi-shield-fill-check"></i>
                            <span>No uses información personal</span>
                        </li>
                        <li>
                            <i class="bi bi-arrow-repeat"></i>
                            <span>No reutilices contraseñas anteriores</span>
                        </li>
                        <li>
                            <i class="bi bi-incognito"></i>
                            <span>Nunca compartas tu contraseña</span>
                        </li>
                    </ul>
                </div>

                <!-- Decorative Elements -->
                <div class="illustration-decorations">
                    <div class="decoration decoration-1"></div>
                    <div class="decoration decoration-2"></div>
                    <div class="decoration decoration-3"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script>
        $(function () {
            // Form validation
            $("#FormRestablecerContrasena").validate({
                rules: {
                    new_password: {
                        required: true,
                        minlength: 8
                    },
                    confirm_password: {
                        required: true,
                        equalTo: "#new_password"
                    }
                },
                messages: {
                    new_password: {
                        required: "La contraseña es requerida",
                        minlength: "La contraseña debe tener al menos 8 caracteres"
                    },
                    confirm_password: {
                        required: "Confirma tu contraseña",
                        equalTo: "Las contraseñas no coinciden"
                    }
                },
                errorElement: "span",
                errorClass: "error",
                errorPlacement: function (error, element) {
                    error.insertAfter(element.closest(".form-floating-custom"));
                },
                highlight: function (element) {
                    $(element)
                        .addClass("error")
                        .closest(".form-floating-custom")
                        .find(".input-icon")
                        .css("color", "var(--login-danger)");
                },
                unhighlight: function (element) {
                    $(element)
                        .removeClass("error")
                        .closest(".form-floating-custom")
                        .find(".input-icon")
                        .css("color", "");
                },
                submitHandler: function (form) {
                    const $btn = $(form).find(".btn-login");
                    $btn.prop("disabled", true)
                        .html('<span class="spinner-border spinner-border-sm me-2" role="status"></span>Actualizando...');
                    form.submit();
                }
            });

            // Password visibility toggle
            $(document).on("click", ".password-toggle", function (e) {
                e.preventDefault();
                const $wrapper = $(this).closest(".form-floating-custom");
                const $input = $wrapper.find("input");
                const $icon = $(this).find("i");

                if ($input.attr("type") === "password") {
                    $input.attr("type", "text");
                    $icon.removeClass("bi-eye").addClass("bi-eye-slash");
                } else {
                    $input.attr("type", "password");
                    $icon.removeClass("bi-eye-slash").addClass("bi-eye");
                }
            });

            // Password requirements validation (real-time)
            $("#new_password").on("input", function () {
                const password = $(this).val();

                // Length check
                updateRequirement("#req-length", password.length >= 8);

                // Uppercase check
                updateRequirement("#req-uppercase", /[A-Z]/.test(password));

                // Number check
                updateRequirement("#req-number", /[0-9]/.test(password));
            });

            function updateRequirement(selector, isValid) {
                const $req = $(selector);
                const $icon = $req.find("i");

                if (isValid) {
                    $req.addClass("valid");
                    $icon.removeClass("bi-circle").addClass("bi-check-circle-fill");
                } else {
                    $req.removeClass("valid");
                    $icon.removeClass("bi-check-circle-fill").addClass("bi-circle");
                }
            }

            // Focus effect
            $(".form-input").on("focus", function () {
                $(this).closest(".form-floating-custom").addClass("focused");
            }).on("blur", function () {
                $(this).closest(".form-floating-custom").removeClass("focused");
            });
        });
    </script>
}
