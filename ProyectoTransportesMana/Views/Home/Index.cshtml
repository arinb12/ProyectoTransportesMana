@model UsuarioModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_LayoutExterno";
}

<div class="login-page">
    <!-- Animated Background -->
    <div class="login-bg">
        <div class="login-bg-shape login-bg-shape-1"></div>
        <div class="login-bg-shape login-bg-shape-2"></div>
        <div class="login-bg-shape login-bg-shape-3"></div>
    </div>

    <!-- Main Container -->
    <div class="login-wrapper">
        <div class="login-card">
            <!-- Left Panel - Form -->
            <div class="login-form-panel">
                <!-- Logo & Brand -->
                <div class="login-brand">
                    <div class="login-logo">
                        <i class="bi bi-bus-front-fill"></i>
                    </div>
                    <span class="login-brand-text">Transporte Maná</span>
                </div>

                <!-- Welcome Text -->
                <div class="login-welcome">
                    <h1>¡Bienvenido de nuevo!</h1>
                    <p>Inicia sesión para gestionar tus rutas y horarios de transporte escolar.</p>
                </div>

                <!-- Error Message -->
                @if (ViewBag.Mensaje != null)
                {
                    <div class="login-alert" role="alert">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span>@ViewBag.Mensaje</span>
                    </div>
                }

                <!-- Login Form -->
                <form id="FormInicioSesion" class="login-form" asp-action="Index" asp-controller="Home" novalidate>
                    <!-- Email Field -->
                    <div class="form-floating-custom">
                        <div class="input-icon">
                            <i class="bi bi-envelope"></i>
                        </div>
                        <input type="email"
                               id="Correo"
                               name="Correo"
                               class="form-input"
                               placeholder="correo@ejemplo.com"
                               asp-for="Correo"
                               autocomplete="email"
                               required />
                        <label for="Correo">Correo electrónico</label>
                    </div>

                    <!-- Password Field -->
                    <div class="form-floating-custom">
                        <div class="input-icon">
                            <i class="bi bi-lock"></i>
                        </div>
                        <input type="password"
                               id="ContrasenaHash"
                               name="ContrasenaHash"
                               class="form-input"
                               placeholder="••••••••"
                               asp-for="ContrasenaHash"
                               autocomplete="current-password"
                               required />
                        <label for="ContrasenaHash">Contraseña</label>
                        <button type="button" class="password-toggle" aria-label="Mostrar contraseña">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                    <!-- Remember & Forgot -->
                    <div class="login-options">
                        <label class="remember-check">
                            <input type="checkbox" id="remember" name="remember" />
                            <span class="checkmark"></span>
                            <span class="remember-text">Recordarme</span>
                        </label>
                        <a asp-controller="Home" asp-action="RecoverPassword" class="forgot-link">
                            ¿Olvidaste tu contraseña?
                        </a>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn-login">
                        <span>Iniciar Sesión</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </form>

                <!-- Footer -->
                <div class="login-footer">
                    <p>© @DateTime.Now.Year Transporte Escolar Maná. Todos los derechos reservados.</p>
                </div>
            </div>

            <!-- Right Panel - Illustration -->
            <div class="login-illustration-panel">
                <div class="illustration-content">
                    <div class="illustration-icon">
                        <i class="bi bi-bus-front"></i>
                    </div>
                    <h2>Gestión de Transporte Escolar</h2>
                    <p>Administra rutas, horarios y puntos de abordaje de forma rápida, segura y eficiente.</p>

                    <!-- Feature List -->
                    <ul class="feature-list">
                        <li>
                            <i class="bi bi-geo-alt-fill"></i>
                            <span>Control de asistencia en tiempo real</span>
                        </li>
                        <li>
                            <i class="bi bi-people-fill"></i>
                            <span>Gestión de estudiantes y horarios</span>
                        </li>
                        <li>
                            <i class="bi bi-shield-check"></i>
                            <span>Seguridad y confiabilidad</span>
                        </li>
                    </ul>
                </div>

                <!-- Decorative Elements -->
                <div class="illustration-decorations">
                    <div class="decoration decoration-1"></div>
                    <div class="decoration decoration-2"></div>
                    <div class="decoration decoration-3"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="~/js/home/inicio-sesion.js" asp-append-version="true"></script>
}