@{
    ViewData["Title"] = "Recuperar Contraseña";
    Layout = "_LayoutExterno";
}

<div class="login-page">
    <!-- Animated Background -->
    <div class="login-bg">
        <div class="login-bg-shape login-bg-shape-1"></div>
        <div class="login-bg-shape login-bg-shape-2"></div>
        <div class="login-bg-shape login-bg-shape-3"></div>
    </div>

    <!-- Main Container -->
    <div class="login-wrapper">
        <div class="login-card">
            <!-- Left Panel - Form -->
            <div class="login-form-panel">
                <!-- Logo & Brand -->
                <div class="login-brand">
                    <div class="login-logo">
                        <i class="bi bi-bus-front-fill"></i>
                    </div>
                    <span class="login-brand-text">Transporte Maná</span>
                </div>

                <!-- Header Text -->
                <div class="login-welcome">
                    <h1>Recuperar Contraseña</h1>
                    <p>Ingresa tu correo electrónico y te enviaremos instrucciones para restablecer tu contraseña.</p>
                </div>

                <!-- Success/Error Message -->
                @if (ViewBag.Mensaje != null)
                {
                    <div class="login-alert" role="alert">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span>@ViewBag.Mensaje</span>
                    </div>
                }

                @if (ViewBag.Success != null)
                {
                    <div class="login-alert login-alert-success" role="alert">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>@ViewBag.Success</span>
                    </div>
                }

                <!-- Recovery Form -->
                <form id="FormRecuperarContrasena" class="login-form" method="post" asp-action="RecoverPassword" asp-controller="Home" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- Email Field -->
                    <div class="form-floating-custom">
                        <div class="input-icon">
                            <i class="bi bi-envelope"></i>
                        </div>
                        <input type="email"
                               id="correo"
                               name="correo"
                               class="form-input"
                               placeholder="correo@ejemplo.com"
                               autocomplete="email"
                               required />
                        <label for="correo">Correo electrónico</label>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn-login">
                        <span>Enviar Instrucciones</span>
                        <i class="bi bi-send"></i>
                    </button>
                </form>

                <!-- Back to Login -->
                <div class="login-back">
                    <a asp-action="Index" asp-controller="Home" class="back-link">
                        <i class="bi bi-arrow-left"></i>
                        <span>Volver al inicio de sesión</span>
                    </a>
                </div>

                <!-- Footer -->
                <div class="login-footer">
                    <p>© @DateTime.Now.Year Transporte Escolar Maná. Todos los derechos reservados.</p>
                </div>
            </div>

            <!-- Right Panel - Illustration -->
            <div class="login-illustration-panel">
                <div class="illustration-content">
                    <div class="illustration-icon">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <h2>Tu seguridad es importante</h2>
                    <p>Recupera el acceso a tu cuenta de forma rápida y segura.</p>

                    <!-- Security Features -->
                    <ul class="feature-list">
                        <li>
                            <i class="bi bi-envelope-check-fill"></i>
                            <span>Verificación por correo electrónico</span>
                        </li>
                        <li>
                            <i class="bi bi-lock-fill"></i>
                            <span>Enlace seguro de un solo uso</span>
                        </li>
                        <li>
                            <i class="bi bi-clock-history"></i>
                            <span>Expira en 24 horas</span>
                        </li>
                    </ul>
                </div>

                <!-- Decorative Elements -->
                <div class="illustration-decorations">
                    <div class="decoration decoration-1"></div>
                    <div class="decoration decoration-2"></div>
                    <div class="decoration decoration-3"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script>
        $(function () {
            $("#FormRecuperarContrasena").validate({
                rules: {
                    correo: {
                        required: true,
                        email: true
                    }
                },
                messages: {
                    correo: {
                        required: "El correo electrónico es requerido",
                        email: "Ingresa un correo electrónico válido"
                    }
                },
                errorElement: "span",
                errorClass: "error",
                errorPlacement: function (error, element) {
                    error.insertAfter(element.closest(".form-floating-custom"));
                },
                highlight: function (element) {
                    $(element)
                        .addClass("error")
                        .closest(".form-floating-custom")
                        .find(".input-icon")
                        .css("color", "var(--login-danger)");
                },
                unhighlight: function (element) {
                    $(element)
                        .removeClass("error")
                        .closest(".form-floating-custom")
                        .find(".input-icon")
                        .css("color", "");
                },
                submitHandler: function (form) {
                    const $btn = $(form).find(".btn-login");
                    $btn.prop("disabled", true)
                        .html('<span class="spinner-border spinner-border-sm me-2" role="status"></span>Enviando...');
                    form.submit();
                }
            });

            // Focus effect
            $(".form-input").on("focus", function () {
                $(this).closest(".form-floating-custom").addClass("focused");
            }).on("blur", function () {
                $(this).closest(".form-floating-custom").removeClass("focused");
            });
        });
    </script>
}