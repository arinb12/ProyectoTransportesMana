@using System
@model EstudianteModel

@{
    ViewData["Title"] = "Gestión Estudiantes";
    Layout = "_LayoutInterno";
    var lista = ViewBag.Estudiantes as List<ProyectoTransportesMana.Contracts.Estudiantes.EstudianteListItemResponse>;
}

@functions {
    public (string Nombres, string Apellidos) PartirNombre(string? full)
    {
        if (string.IsNullOrWhiteSpace(full)) return ("", "");
        var parts = full.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return (parts[0], "");
        if (parts.Length == 2) return (parts[0], parts[1]);

        var apellidos = parts[^2] + " " + parts[^1];
        var nombres = string.Join(" ", parts, 0, parts.Length - 2);
        return (nombres, apellidos);
    }
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/pages/principal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/datatables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/estudiantes/gestion-estudiantes.css" asp-append-version="true" />
}

<!-- Loading Overlay -->
<div class="tm-loading-overlay" id="loading-overlay">
    <div class="tm-loading-content">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-3 tm-text-muted">Cargando estudiantes...</p>
    </div>
</div>

<!-- Page Header -->
<div class="tm-page-header">
    <h1 class="tm-page-title">
        <i class="bi bi-mortarboard-fill"></i>
        Gestión de Estudiantes
    </h1>
    <button class="tm-btn tm-btn-primary" data-bs-toggle="modal" data-bs-target="#modalEstudiante" onclick="nuevoEstudiante()">
        <i class="bi bi-plus-lg me-1"></i>
        Nuevo Estudiante
    </button>
</div>

<!-- Stats Cards -->
<div class="tm-stats-grid">
    <div class="tm-stat-card">
        <div class="tm-stat-icon primary">
            <i class="bi bi-people-fill"></i>
        </div>
        <div class="tm-stat-content">
            <div class="tm-stat-value" id="stats-total-estudiantes">@(lista?.Count ?? 0)</div>
            <div class="tm-stat-label">Total Estudiantes</div>
        </div>
    </div>
    <div class="tm-stat-card">
        <div class="tm-stat-icon secondary">
            <i class="bi bi-person-check-fill"></i>
        </div>
        <div class="tm-stat-content">
            <div class="tm-stat-value" id="stats-estudiantes-activos">@(lista?.Count(e => e.Activo) ?? 0)</div>
            <div class="tm-stat-label">Estudiantes Activos</div>
        </div>
    </div>
    <div class="tm-stat-card">
        <div class="tm-stat-icon accent">
            <i class="bi bi-building-fill"></i>
        </div>
        <div class="tm-stat-content">
            <div class="tm-stat-value" id="stats-instituciones">@(lista?.Select(e => e.Institucion).Distinct().Count() ?? 0)</div>
            <div class="tm-stat-label">Instituciones</div>
        </div>
    </div>
</div>

<!-- Students Table Card -->
<div class="tm-card">
    <div class="tm-card-header">
        <span><i class="bi bi-table me-2"></i>Listado de Estudiantes</span>
    </div>
    <div class="tm-card-body">
        <table id="tablaEstudiantes" class="table table-hover w-100">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Apellidos</th>
                    <th>Encargado Legal</th>
                    <th>Institución</th>
                    <th>Maestra</th>
                    <th>Sección</th>
                    <th>Teléfono</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (lista != null && lista.Count > 0)
                {
                    foreach (var e in lista)
                    {
                        var split = PartirNombre(e.NombreCompletoEstudiante);
                        <tr>
                            <td>@split.Nombres</td>
                            <td>@split.Apellidos</td>
                            <td>@e.Encargado</td>
                            <td>@e.Institucion</td>
                            <td>@e.Maestra</td>
                            <td>@e.Seccion</td>
                            <td>@e.Telefono</td>
                            <td class="text-center">
                                <div class="form-check form-switch d-flex justify-content-center">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           role="switch"
                                           id="estado-@e.Id"
                                           @(e.Activo ? "checked" : null)
                                           onchange="cambiarEstadoEstudiante(@e.Id, this.checked)" />
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="tm-action-buttons">
                                    <button class="tm-btn tm-btn-sm tm-btn-outline"
                                            title="Editar"
                                            onclick="editarEstudiante(@e.Id)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="tm-btn tm-btn-sm tm-btn-danger"
                                            title="Eliminar"
                                            onclick="eliminarEstudiante(@e.Id)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Nuevo/Editar Estudiante -->
<div class="modal fade" id="modalEstudiante" tabindex="-1" aria-labelledby="modalEstudianteLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEstudianteLabel">
                    <i class="bi bi-mortarboard me-2"></i>
                    Registrar Estudiante
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="estudianteForm"
                      action="/Estudiantes/RegistrarEstudiante"
                      method="post"
                      class="row g-3 needs-validation">

                    @Html.AntiForgeryToken()
                    <input type="hidden" id="IdUsuario" name="IdUsuario" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- Nombre -->
                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label">
                            Nombre <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ingrese el nombre" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <!-- Primer Apellido -->
                    <div class="col-md-3">
                        <label asp-for="PrimerApellido" class="form-label">
                            Primer Apellido <span class="text-danger">*</span>
                        </label>
                        <input asp-for="PrimerApellido" class="form-control" placeholder="Primer apellido" />
                        <span asp-validation-for="PrimerApellido" class="text-danger"></span>
                    </div>

                    <!-- Segundo Apellido -->
                    <div class="col-md-3">
                        <label asp-for="SegundoApellido" class="form-label">Segundo Apellido</label>
                        <input asp-for="SegundoApellido" class="form-control" placeholder="Segundo apellido" />
                        <span asp-validation-for="SegundoApellido" class="text-danger"></span>
                    </div>

                    <!-- Encargado Legal -->
                    <div class="col-md-6">
                        <label asp-for="IdEncargado" class="form-label">
                            Encargado Legal <span class="text-danger">*</span>
                        </label>
                        <select asp-for="IdEncargado"
                                class="form-select select2"
                                asp-items="ViewBag.Encargados"
                                data-placeholder="Seleccione un encargado">
                            <option value=""></option>
                        </select>
                        <span asp-validation-for="IdEncargado" class="text-danger"></span>
                    </div>

                    <!-- Institución -->
                    <div class="col-md-6">
                        <label asp-for="IdInstitucion" class="form-label">
                            Institución <span class="text-danger">*</span>
                        </label>
                        <select asp-for="IdInstitucion"
                                class="form-select select2"
                                asp-items="ViewBag.Instituciones"
                                data-placeholder="Seleccione una institución">
                            <option value=""></option>
                        </select>
                        <span asp-validation-for="IdInstitucion" class="text-danger"></span>
                    </div>

                    <!-- Maestra -->
                    <div class="col-md-6">
                        <label asp-for="IdMaestra" class="form-label">Maestra</label>
                        <select asp-for="IdMaestra"
                                class="form-select select2"
                                asp-items="ViewBag.Maestras"
                                data-placeholder="Seleccione una maestra">
                            <option value=""></option>
                        </select>
                        <span asp-validation-for="IdMaestra" class="text-danger"></span>
                    </div>

                    <!-- Sección -->
                    <div class="col-md-3">
                        <label asp-for="Seccion" class="form-label">Sección</label>
                        <input asp-for="Seccion" class="form-control" placeholder="Ej: 1-A" />
                        <span asp-validation-for="Seccion" class="text-danger"></span>
                    </div>

                    <!-- Teléfono -->
                    <div class="col-md-3">
                        <label asp-for="Telefono" class="form-label">Teléfono</label>
                        <input asp-for="Telefono"
                               class="form-control"
                               id="Telefono"
                               inputmode="tel"
                               autocomplete="tel"
                               placeholder="####-####" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>

                    <!-- Busetas -->
                    <div class="col-md-9">
                        <label for="Busetas" class="form-label">Busetas Asignadas</label>
                        <select id="Busetas"
                                name="Busetas"
                                class="form-select select2-multiple"
                                multiple="multiple"
                                data-placeholder="Seleccione una o varias busetas">
                        </select>
                        <div class="form-text">Puede seleccionar más de una buseta.</div>
                    </div>

                    <!-- Activo -->
                    <div class="col-md-3 d-flex align-items-center">
                        <div class="form-check form-switch mt-4">
                            <input class="form-check-input" type="checkbox" asp-for="Activo" id="ActivoCheck" />
                            <label class="form-check-label" for="ActivoCheck">Activo</label>
                        </div>
                        <span asp-validation-for="Activo" class="text-danger"></span>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="tm-btn tm-btn-outline" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="submit" form="estudianteForm" class="tm-btn tm-btn-primary">
                    <i class="bi bi-check-lg me-1"></i>
                    Guardar Estudiante
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Confirmar Eliminación -->
<div class="modal fade" id="modalConfirmarEliminar" tabindex="-1" aria-labelledby="modalConfirmarEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalConfirmarEliminarLabel">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
                    Confirmar Eliminación
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">¿Está seguro que desea eliminar este estudiante? Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="tm-btn tm-btn-outline" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="button" class="tm-btn tm-btn-danger" id="btnConfirmarEliminar">
                    <i class="bi bi-trash me-1"></i>
                    Eliminar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        // SweetAlert payload from server
        window.__swalPayload = {
            type: '@Html.Raw(TempData["SwalType"] ?? ViewData["SwalType"] ?? "")',
            title: '@Html.Raw(TempData["SwalTitle"] ?? ViewData["SwalTitle"] ?? "")',
            text: '@Html.Raw(TempData["SwalText"] ?? ViewData["SwalText"] ?? "")'
        };
    </script>

    <script src="~/js/estudiantes/gestion-estudiantes.js" asp-append-version="true"></script>
}