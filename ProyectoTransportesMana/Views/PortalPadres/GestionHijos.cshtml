@model IEnumerable<ProyectoTransportesMana.Contracts.Estudiantes.EstudianteListItemResponse>

@{
    ViewData["Title"] = "Mis hijos";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/pages/principal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/datatables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/gestion-common.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/padres/portal-padres.css" asp-append-version="true" />

}

<!-- ========== ENCABEZADO ========== -->
<div class="tm-page-header">
    <h1 class="tm-page-title">
        <i class="bi bi-people-fill"></i>
        Mis hijos
    </h1>
    <p class="tm-page-subtitle">Estudiantes vinculados a su cuenta</p>
</div>

<!-- ========== LISTADO DE HIJOS EN TARJETAS ========== -->
@if (Model != null && Model.Any())
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var est in Model)
        {
            <div class="col">
                <div class="tm-child-schedule-card h-100 d-flex flex-column">
                    <div class="tm-child-schedule-header">
                        <div class="tm-child-info">
                            <h5 class="tm-child-name">
                                @est.NombreCompletoEstudiante
                                <small class="text-muted">(@est.Institucion)</small>
                            </h5>
                        </div>
                    </div>
                    <div class="tm-child-details-grid flex-grow-1">
                        <div class="tm-child-detail-item">
                            <span class="tm-child-detail-label">Encargado</span>
                            <span class="tm-child-detail-value">@est.Encargado</span>
                        </div>
                        <div class="tm-child-detail-item">
                            <span class="tm-child-detail-label">Sección</span>
                            <span class="tm-child-detail-value">@est.Seccion</span>
                        </div>
                        <div class="tm-child-detail-item">
                            <span class="tm-child-detail-label">Maestra</span>
                            <span class="tm-child-detail-value">@est.Maestra</span>
                        </div>
                        <div class="tm-child-detail-item">
                            <span class="tm-child-detail-label">Teléfono</span>
                            <span class="tm-child-detail-value">@est.Telefono</span>
                        </div>
                    </div>
                    <div class="mt-3 text-end">
                        <button type="button" class="tm-btn tm-btn-primary btn-editar-horario" data-id-estudiante="@est.Id"
                                data-nombre-estudiante="@est.NombreCompletoEstudiante">
                            <i class="bi bi-calendar-week me-1"></i>Configurar horario anual
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="tm-empty-state">
        <i class="bi bi-people"></i>
        <p>No hay estudiantes vinculados a este encargado legal.</p>
        <small class="text-muted">Puede agregar estudiantes desde el portal de administración.</small>
    </div>
}

<!-- ========== MODAL PARA EDITAR HORARIO ========== -->
<div class="modal fade" id="modalHorario" tabindex="-1" aria-labelledby="modalHorarioLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header tm-modal-header">
                <h5 class="modal-title" id="modalHorarioLabel">
                    <i class="bi bi-calendar-week-fill me-2"></i>Horario anual
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalHorarioBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2 text-muted">Cargando horario...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/shared/gestion-common.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
        const modalElement = document.getElementById('modalHorario');
        const modal = new bootstrap.Modal(modalElement);
        const modalBody = document.getElementById('modalHorarioBody');
        const modalTitle = document.getElementById('modalHorarioLabel');

        document.querySelectorAll('.btn-editar-horario').forEach(btn => {
        btn.addEventListener('click', function () {
        const idEstudiante = this.dataset.idEstudiante;
        const nombre = this.dataset.nombreEstudiante;
        modalTitle.innerHTML = `<i class="bi bi-calendar-week-fill me-2"></i>Horario anual de ${nombre}`;
        modalBody.innerHTML = `
        <div class="text-center py-4">
        <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-2 text-muted">Cargando horario...</p>
        </div>
        `;

        fetch(`/PortalPadres/EditarHorario?idEstudiante=${idEstudiante}`)
        .then(r => {
        if (!r.ok) throw new Error('Error al cargar el horario');
        return r.text();
        })
        .then(html => {
        modalBody.innerHTML = html;

        const form = modalBody.querySelector('form');
        if (form) {
        form.addEventListener('submit', function (e) {
        e.preventDefault();

        const formData = new FormData(form);
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (token) formData.append('__RequestVerificationToken', token);

        fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: {
        'X-Requested-With': 'XMLHttpRequest'
        }
        })
        .then(r => {
        if (!r.ok) throw new Error('Error al guardar el horario');
        return r.json();
        })
        .then(data => {
        if (data && data.ok) {
        modal.hide();
        // Mostrar notificación de éxito (usando GestionCommon si existe)
        if (window.GestionCommon) {
        window.GestionCommon.showNotification('success', 'Horario guardado', 'El horario fue actualizado correctamente.', true);
        }
        setTimeout(() => location.reload(), 1500);
        } else {
        throw new Error(data?.message || 'Error al guardar');
        }
        })
        .catch(err => {
        alert(err.message);
        });
        });
        }

        modal.show();
        })
        .catch(err => {
        modalBody.innerHTML = `<div class="alert alert-danger m-3">${err.message}</div>`;
        modal.show();
        });
        });
        });
        });
    </script>
}