@using ProyectoTransportesMana.Contracts.EncargadosLegales
@model ProyectoTransportesMana.Models.EncargadoLegalModel

@{
    ViewData["Title"] = "Gestión Padres";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";

    var encargados = ViewBag.Encargados as List<EncargadoLegalListItemResponse> ?? new();
    var totalEncargados = encargados.Count;
    var encargadosActivos = encargados.Count(e => e.Activo);
    var encargadosInactivos = totalEncargados - encargadosActivos;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/principal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/datatables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/gestion-common.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/encargados-legales/gestion-encargados.css" asp-append-version="true" />
}

<!-- Loading Overlay -->
<div class="tm-loading-overlay" id="loading-overlay" style="display: none;">
    <div class="tm-loading-content">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-3 tm-text-muted">Cargando padres...</p>
    </div>
</div>

<!-- Page Header -->
<div class="tm-page-header">
    <h1 class="tm-page-title">
        <i class="bi bi-people-fill"></i>
        Gestión de Padres
    </h1>
    <button class="tm-btn tm-btn-primary" data-bs-toggle="modal" data-bs-target="#modalEncargado" onclick="nuevoEncargado()">
        <i class="bi bi-plus-lg me-1"></i>
        Nuevo Padre
    </button>
</div>

<!-- Stats Cards -->
<div class="tm-stats-grid">
    <div class="tm-stat-card">
        <div class="tm-stat-icon primary">
            <i class="bi bi-people-fill"></i>
        </div>
        <div class="tm-stat-content">
            <div class="tm-stat-value" id="stats-total-encargados">@totalEncargados</div>
            <div class="tm-stat-label">Total Padres</div>
        </div>
    </div>
    <div class="tm-stat-card">
        <div class="tm-stat-icon secondary">
            <i class="bi bi-person-check-fill"></i>
        </div>
        <div class="tm-stat-content">
            <div class="tm-stat-value" id="stats-encargados-activos">@encargadosActivos</div>
            <div class="tm-stat-label">Padres Activos</div>
        </div>
    </div>
    <div class="tm-stat-card">
        <div class="tm-stat-icon accent">
            <i class="bi bi-person-x-fill"></i>
        </div>
        <div class="tm-stat-content">
            <div class="tm-stat-value" id="stats-encargados-inactivos">@encargadosInactivos</div>
            <div class="tm-stat-label">Padres Inactivos</div>
        </div>
    </div>
</div>

<!-- Desktop: Encargados Table Card -->
<div class="tm-card tm-encargados-desktop">
    <div class="tm-card-header">
        <span><i class="bi bi-table me-2"></i>Listado de Padres</span>
    </div>
    <div class="tm-card-body">
        <table id="tablaEncargados" class="table table-hover w-100">
            <thead>
                <tr>
                    <th>Nombre Completo</th>
                    <th>Estudiante</th>
                    <th>Estado Contrato</th>
                    <th>Fecha Inicio</th>
                    <th>Dirección</th>
                    <th>Teléfono</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Credenciales</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody id="tbodyEncargados">
                @foreach (var e in encargados)
                {
                    <tr data-id="@e.IdUsuario">
                        <td>@e.NombreCompleto</td>
                        <td>@(string.IsNullOrWhiteSpace(e.Estudiantes) ? "-" : e.Estudiantes)</td>
                        <td>@e.EstadoContrato</td>
                        <td>@(e.FechaInicio?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>@e.Direccion</td>
                        <td>@e.Telefono</td>
                        <td class="text-center">
                            @if (e.Activo)
                            {
                                <span class="tm-badge tm-badge-success">
                                    <i class="bi bi-check-circle-fill"></i> Activo
                                </span>
                            }
                            else
                            {
                                <span class="tm-badge tm-badge-danger">
                                    <i class="bi bi-x-circle-fill"></i> Inactivo
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            <button class="tm-btn tm-btn-outline tm-btn-sm"
                                    onclick="enviarContrasena(@e.IdUsuario)"
                                    title="Enviar contraseña temporal">
                                <i class="bi bi-envelope-fill"></i>
                            </button>
                        </td>
                        <td class="text-center">
                            <div class="tm-action-buttons">
                                <button class="tm-btn tm-btn-outline tm-btn-sm"
                                        title="Editar"
                                        onclick="editarEncargado(@e.IdUsuario)">
                                    <i class="bi bi-pencil-fill"></i>
                                </button>
                                <button class="tm-btn tm-btn-danger tm-btn-sm"
                                        title="Eliminar"
                                        onclick="eliminarEncargado(@e.IdUsuario)">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Mobile: Encargados Cards View -->
<div class="tm-card tm-encargados-mobile">
    <div class="tm-card-header">
        <span><i class="bi bi-people me-2"></i>Listado de Padres</span>
    </div>

    <!-- Mobile Controls -->
    <div class="tm-mobile-controls">
        <div class="tm-mobile-search">
            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" class="form-control" id="mobileSearchEncargados"
                       placeholder="Buscar padre...">
            </div>
        </div>
        <div class="tm-mobile-filter">
            <select class="form-select" id="mobileFilterEstado">
                <option value="">Todos</option>
                <option value="activo">Activos</option>
                <option value="inactivo">Inactivos</option>
            </select>
            <select class="form-select" id="mobilePageSize">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
            </select>
        </div>
    </div>

    <!-- Encargado Cards Container -->
    <div class="tm-encargado-cards" id="encargadoCardsContainer">
        <!-- Cards will be rendered here by JavaScript -->
    </div>

    <!-- Mobile Pagination -->
    <div class="tm-mobile-pagination" id="mobilePaginationEncargados">
        <div class="tm-pagination-info">
            Mostrando <strong>1-10</strong> de <strong>0</strong> padres
        </div>
        <div class="tm-pagination-controls">
            <button class="tm-page-btn tm-page-prev" disabled>
                <i class="bi bi-chevron-left"></i>
            </button>
            <div class="tm-page-numbers">
                <!-- Page numbers rendered by JS -->
            </div>
            <button class="tm-page-btn tm-page-next" disabled>
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>
</div>

<!-- Hidden data for JavaScript -->
<script type="application/json" id="encargadosData">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(encargados.Select(e => new {
        idUsuario = e.IdUsuario,
                nombreCompleto = e.NombreCompleto,
                estudiantes = e.Estudiantes ?? "-",
                estadoContrato = e.EstadoContrato,
                fechaInicio = e.FechaInicio?.ToString("dd/MM/yyyy") ?? "-",
                direccion = e.Direccion,
                telefono = e.Telefono,
                activo = e.Activo
        })))
</script>

<!-- Modal: Nuevo/Editar Encargado -->
<div class="modal fade" id="modalEncargado" tabindex="-1" aria-labelledby="modalEncargadoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEncargadoLabel">
                    <i class="bi bi-person-plus me-2"></i>
                    Registrar Padre
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="encargadoForm" class="row g-3" novalidate>
                    @Html.AntiForgeryToken()

                    <input type="hidden" id="IdUsuario" value="0" />
                    <input type="hidden" id="AceptoTerminos" value="false" />
                    <input type="hidden" id="Activo" value="true" />

                    <!-- Nombre -->
                    <div class="col-md-4">
                        <label for="Nombre" class="form-label">
                            Nombre <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="Nombre" class="form-control"
                               placeholder="Ingrese el nombre" required />
                    </div>

                    <!-- Primer Apellido -->
                    <div class="col-md-4">
                        <label for="PrimerApellido" class="form-label">
                            Primer Apellido <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="PrimerApellido" class="form-control"
                               placeholder="Ingrese primer apellido" required />
                    </div>

                    <!-- Segundo Apellido -->
                    <div class="col-md-4">
                        <label for="SegundoApellido" class="form-label">
                            Segundo Apellido
                        </label>
                        <input type="text" id="SegundoApellido" class="form-control"
                               placeholder="Ingrese segundo apellido" />
                    </div>

                    <!-- Correo -->
                    <div class="col-md-6">
                        <label for="Correo" class="form-label">
                            Correo Electrónico <span class="text-danger">*</span>
                        </label>
                        <input type="email" id="Correo" class="form-control"
                               placeholder="ejemplo@correo.com" required />
                    </div>

                    <!-- Teléfono -->
                    <div class="col-md-6">
                        <label for="Telefono" class="form-label">
                            Teléfono <span class="text-danger">*</span>
                        </label>
                        <input type="tel" id="Telefono" class="form-control"
                               placeholder="Ej: 8888-8888" required />
                    </div>

                    <!-- Fecha de Inicio -->
                    <div class="col-md-6">
                        <label for="FirmaContrato" class="form-label">
                            Fecha de Inicio
                        </label>
                        <input type="date" id="FirmaContrato" class="form-control" />
                    </div>

                    <!-- Dirección -->
                    <div class="col-md-6">
                        <label for="DireccionResidencia" class="form-label">
                            Dirección
                        </label>
                        <input type="text" id="DireccionResidencia" class="form-control"
                               placeholder="Ingrese la dirección" />
                    </div>

                    <!-- Estado Activo (solo visible en edición) -->
                    <div class="col-md-12" id="activoContainer" style="display: none;">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="ActivoSwitch" checked />
                            <label class="form-check-label" for="ActivoSwitch">Activo</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="tm-btn tm-btn-outline" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="submit" form="encargadoForm" class="tm-btn tm-btn-primary">
                    <i class="bi bi-check-lg me-1"></i>
                    Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/utilitarios/utilitarios.js" asp-append-version="true"></script>
    <script src="~/js/utilitarios/swal-helpers.js" asp-append-version="true"></script>
    <script src="~/js/shared/gestion-common.js" asp-append-version="true"></script>
    <script src="~/js/encargados-legales/gestion-encargados.js" asp-append-version="true"></script>
    <script>
        // URL endpoints for JavaScript
        window.EncargadosConfig = {
            urls: {
                obtenerParaEditar: '@Url.Action("ObtenerParaEditar", "EncargadosLegales")',
                registrar: '@Url.Action("RegistrarEncargado", "EncargadosLegales")',
                actualizar: '@Url.Action("ActualizarEncargado", "EncargadosLegales")',
                eliminar: '@Url.Action("EliminarEncargado", "EncargadosLegales")',
                resetCredenciales: '@Url.Action("ResetCredencialesEncargado", "Cuenta")'
            }
        };
    </script>
}