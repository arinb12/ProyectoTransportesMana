@{
    ViewData["Title"] = "Consultar Alertas";
    Layout = "_LayoutInterno";
    int? rolActual = Context.Session.GetInt32("IdRol");
}

@section Styles {
    <link rel="stylesheet" href="~/css/components/datatables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/principal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/alertas/alertas.css" asp-append-version="true" />
}

<!-- Loading Overlay -->
<div class="tm-loading-overlay" id="loading-overlay">
    <div class="tm-loading-content">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-3 tm-text-muted">Cargando alertas...</p>
    </div>
</div>

<!-- Page Header -->
<div class="tm-page-header">
    <h1 class="tm-page-title">
        <i class="bi bi-bell-fill"></i>
        Alertas Informativas
    </h1>
    @if (rolActual == 1 || rolActual == 5)
    {
        <button class="tm-btn tm-btn-primary" data-bs-toggle="modal" data-bs-target="#modalAlerta">
            <i class="bi bi-plus-lg me-1"></i>
            Nueva Alerta
        </button>
    }
</div>

<!-- Stats Cards -->
<div class="tm-stats-grid">
    <div class="tm-stat-card">
        <div class="tm-stat-icon primary">
            <i class="bi bi-megaphone-fill"></i>
        </div>
        <div class="tm-stat-content">
            <div class="tm-stat-value" id="stats-total-alertas">0</div>
            <div class="tm-stat-label">Total Alertas</div>
        </div>
    </div>
    <div class="tm-stat-card">
        <div class="tm-stat-icon secondary">
            <i class="bi bi-envelope-open-fill"></i>
        </div>
        <div class="tm-stat-content">
            <div class="tm-stat-value" id="stats-alertas-leidas">0</div>
            <div class="tm-stat-label">Alertas Leídas</div>
        </div>
    </div>
    <div class="tm-stat-card">
        <div class="tm-stat-icon accent">
            <i class="bi bi-envelope-fill"></i>
        </div>
        <div class="tm-stat-content">
            <div class="tm-stat-value" id="stats-alertas-pendientes">0</div>
            <div class="tm-stat-label">Alertas Pendientes</div>
        </div>
    </div>
</div>

<!-- Desktop: Alerts Table Card -->
<div class="tm-card">
    <div class="tm-card-header">
        <span><i class="bi bi-list-ul me-2"></i>Listado de Alertas</span>
    </div>
    <div class="tm-card-body">
        <table id="tablaAlertas" class="table table-hover w-100">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Título</th>
                    <th>Mensaje</th>
                    <th>Fecha Publicación</th>
                    <th>Destinatario</th>
                    <th>Estado</th>
                    <th>Tipo</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>

        <!-- Mobile View: Alert Cards -->
        <div class="tm-alerts-mobile">
            <!-- Mobile Controls -->
            <div class="tm-mobile-controls">
                <div class="tm-mobile-search">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" class="form-control" id="mobileSearchAlertas"
                               placeholder="Buscar alertas...">
                    </div>
                </div>
                <div class="tm-mobile-filter">
                    <select class="form-select" id="mobileFilterEstado">
                        <option value="">Todos</option>
                        <option value="pendiente">Pendientes</option>
                        <option value="leido">Leídas</option>
                    </select>
                    <select class="form-select" id="mobilePageSize">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                    </select>
                </div>
            </div>

            <!-- Alert Cards Container -->
            <div class="tm-alert-cards" id="alertCardsContainer">
                <!-- Cards will be rendered here by JavaScript -->
            </div>

            <!-- Mobile Pagination -->
            <div class="tm-mobile-pagination" id="mobilePaginationAlertas">
                <div class="tm-pagination-info">
                    Mostrando <strong>1-10</strong> de <strong>0</strong> alertas
                </div>
                <div class="tm-pagination-controls">
                    <button class="tm-page-btn tm-page-prev" disabled>
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <div class="tm-page-numbers">
                        <!-- Page numbers rendered by JS -->
                    </div>
                    <button class="tm-page-btn tm-page-next" disabled>
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Nueva Alerta -->
<div class="modal fade" id="modalAlerta" tabindex="-1" aria-labelledby="modalAlertaLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalAlertaLabel">
                    <i class="bi bi-bell me-2"></i>
                    Registrar Nueva Alerta
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="formAlerta">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">
                                Tipo de Alerta <span class="text-danger">*</span>
                            </label>
                            <div class="tm-btn-group-select" id="tipoAlertaGroup">
                                <input type="radio" name="tipoAlertaRadio" id="tipoRetraso" value="Retraso">
                                <label for="tipoRetraso" class="tm-btn-option">Retraso</label>
                                
                                <input type="radio" name="tipoAlertaRadio" id="tipoCambio" value="Cambio Ruta">
                                <label for="tipoCambio" class="tm-btn-option">Cambio Ruta</label>
                                
                                <input type="radio" name="tipoAlertaRadio" id="tipoEvento" value="Evento Especial">
                                <label for="tipoEvento" class="tm-btn-option">Evento</label>
                                
                                <input type="radio" name="tipoAlertaRadio" id="tipoOtro" value="Otro">
                                <label for="tipoOtro" class="tm-btn-option">Otro</label>
                            </div>
                            <!-- Keep hidden select for form compatibility -->
                            <select id="tipoAlerta" class="d-none" required>
                                <option value="">Seleccione</option>
                                <option value="Retraso">Retraso</option>
                                <option value="Cambio Ruta">Cambio Ruta</option>
                                <option value="Evento Especial">Evento Especial</option>
                                <option value="Otro">Otro</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="fechaPublicacion" class="form-label">
                                Fecha de Publicación <span class="text-danger">*</span>
                            </label>
                            <input type="date" id="fechaPublicacion" class="form-control" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="tituloAlerta" class="form-label">
                            Título <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="tituloAlerta" class="form-control"
                               placeholder="Ingrese el título de la alerta" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label for="contenidoAlerta" class="form-label">Mensaje / Contenido</label>
                        <textarea class="form-control" id="contenidoAlerta" rows="4"
                                  placeholder="Descripción detallada de la alerta..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="publico" class="form-label">Público Destinatario</label>
                        <select id="publico" class="form-select">
                            <option value="todos">Todos (Masiva)</option>
                            <option value="buseta">Por Buseta</option>
                            <option value="encargado">Por Encargado Legal</option>
                        </select>
                    </div>
                    <div class="mb-3 d-none" id="grupoBuseta">
                        <label for="buseta" class="form-label">
                            Selecciona una Buseta <span class="text-danger">*</span>
                        </label>
                        <select id="buseta" class="form-select">
                            <option disabled selected value="">Selecciona una buseta</option>
                        </select>
                    </div>
                    <div class="mb-3 d-none" id="grupoEncargado">
                        <label for="encargado" class="form-label">
                            Selecciona un Encargado Legal <span class="text-danger">*</span>
                        </label>
                        <select id="encargado" class="form-select">
                            <option disabled selected value="">Selecciona un encargado</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="tm-btn tm-btn-outline" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="submit" form="formAlerta" class="tm-btn tm-btn-primary">
                    <i class="bi bi-check-lg me-1"></i>
                    Guardar Alerta
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Confirmar Eliminación -->
<div class="modal fade" id="modalConfirmarEliminar" tabindex="-1" aria-labelledby="modalConfirmarEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalConfirmarEliminarLabel">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
                    Confirmar Eliminación
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">¿Está seguro que desea eliminar esta alerta? Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="tm-btn tm-btn-outline" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="button" class="tm-btn tm-btn-danger" id="btnConfirmarEliminar">
                    <i class="bi bi-trash me-1"></i>
                    Eliminar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @inject IConfiguration Configuration
    <script>
        // API Configuration - Set before loading alertas.js
        window.API_BASE = '@(Configuration["Api:BaseUrl"]?.TrimEnd('/') ?? "https://localhost:7238")';
        window.CURRENT_USER_ID = @(ViewData["CurrentUserId"] ?? 0);
        window.ROL_ACTUAL = @(rolActual ?? 0);
    </script>
    <script src="~/js/utilitarios/utilitarios.js" asp-append-version="true"></script>
    <script src="~/js/pages/alertas.js" asp-append-version="true"></script>
}